### register a new user
POST http://localhost:8000/auth/register
Content-Type: application/json

{
    "username": "Bob",
    "email": "bob@mail.com",
    "password": "password"
}


### login as a user
POST http://localhost:8000/auth/login
Content-Type: application/json

{
    "email": "bob@mail.com",
    "password": "password"
}

### login as another user
POST http://localhost:8000/auth/login
Content-Type: application/json

{
    "email": "alice@mail.com",
    "password": "password"
}

### login as a user with wrong password
POST http://localhost:8000/auth/login
Content-Type: application/json

{
    "email": "alice@mail.com",
    "password": "password"
}

